# ==============================================================================
# BlastRadius Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND ENVIRONMENT VARIABLES (Configure in Render Dashboard)
# ------------------------------------------------------------------------------
PORT=10000
NODE_ENV=production

# The URL of your Vercel frontend (for CORS allowance)
CLIENT_URL=https://your-blastradius.vercel.app

# Neo4j Graph Database Credentials (Neo4j AuraDB or self-hosted)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Google Gemini API Key (for risk review explanations)
GEMINI_API_KEY=your_gemini_api_key

# Optional: Session & Auth
# JWT_SECRET=your_jwt_secret

# ------------------------------------------------------------------------------
# 2. FRONTEND ENVIRONMENT VARIABLES (Configure in Vercel Dashboard)
# ------------------------------------------------------------------------------
# The URL of your deployed Render backend (no trailing slash)
VITE_API_BASE_URL=https://blastradius-backend.onrender.com

# Optional Analytics
# VITE_ANALYTICS_ENDPOINT=https://analytics.example.com
# VITE_ANALYTICS_WEBSITE_ID=your_website_id
